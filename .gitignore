# editor backups
*~

# CMake output produced by building the tools in tools/; note that tools/Makefile
# is tracked, so only the per-tool Makefiles generated by cmake are ignored here
tools/*/CMakeCache.txt
tools/*/CMakeFiles/
tools/*/cmake_install.cmake
tools/*/Makefile
tools/*/install_manifest.txt

# binaries produced by building the tools from source
tools/cgalmesh/mesh_3D_image
tools/cgalmesh/mesh_polyhedral_domain
tools/cgalsimp2/edge_collapse_enriched_polyhedron
tools/cgalsurf/mesh_a_3d_gray_image
tools/meshfix/meshfix
tools/tetgen/tetgen

# binaries copied into bin/ by "make" in tools/; the redistributed ones carry a
# platform suffix (.exe, .mexa64, .mexmaci64, ...) and stay tracked
bin/cgalmesh
bin/cgalpoly
bin/cgalsimp2
bin/cgalsurf
bin/cork
bin/gtsrefine
bin/jmeshlib
bin/meshfix
bin/tetgen
bin/tetgen1.5
bin/*_new
bin/*_old

# output of the MATLAB Compiler project in i2m.prj
i2m/

# meshes and data written by running the demos and the unit tests
*.bmsh
*.jmesh
*.jmsh
sample/tt.json
